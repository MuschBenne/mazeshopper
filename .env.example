# MongoDB anslutningssträng (MongoDB Atlas eller självhostad)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# Resend API-nyckel för e-postutskick (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Avsändaradress för systemmail (måste vara verifierad i Resend)
EMAIL_FROM=noreply@dindoman.se
